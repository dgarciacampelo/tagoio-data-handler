{
  "name": "tagoio-handler-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Svelte 5 pages of the TagoIO data handler: public station page, eMSP dashboard, audits and QR posters (Vite + Tailwind CSS 4 + Paraglide JS 2)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale",
    "check": "npm run paraglide && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run paraglide && vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@inlang/paraglide-js": "2.26.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "20.19.0 || >=22.12.0"
  },
  "volta": {
    "node": "22.21.1"
  }
}
