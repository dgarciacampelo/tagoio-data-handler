# Configuration of the TagoIO data handler (copy to .env). Every variable is required unless marked optional.

# region Service
API_PORT=8080
# APP_ENV=production          # Optional: "development" serves the pages from the Vite dev server and loads .env
# DRY_RUN=false               # Optional: true logs events, TagoIO writes and Telegram messages instead of sending them
# DB_PATH=database_files/database.sqlite3   # Optional
# BACKUPS_TO_KEEP=30          # Optional: newest backup archives kept next to the database
# LOG_LEVEL=info              # Optional: debug, info, warn, error
# endregion

# region Access
APP_DEFAULT_USER=             # HTTP Basic of the machine API (CSMS, notification service)
APP_DEFAULT_TOKEN=
APP_ADMIN_USER=               # Admin dashboards login
APP_ADMIN_TOKEN=
DASHBOARD_SECRET_TOKEN=       # Signs the admin session cookie (at least 16 characters)
SHORT_LINK_URL=https://qr.example.com   # Base of the station QR links
# endregion

# region TagoIO
TAGO_API_ENDPOINT=https://api.tago.io
# TAGO_SSE_URL=https://sse.tago.io/events   # Optional: realtime endpoint of the region
TAGO_ACCOUNT_TOKEN=
TAGO_DEVICE_PREFIX=MASTER-
# Analysis tokens (UUIDs), one realtime connection each:
TAGO_CHANGE_AVAILABILITY_TOKEN=
TAGO_CHANGE_LOAD_BALANCING_MODE_TOKEN=
TAGO_CHANGE_MAX_POWER_GRID_TOKEN=
TAGO_CHANGE_CPO_INFO_TOKEN=
TAGO_CHANGE_RATE_LIST_TOKEN=
TAGO_MANAGE_RFID_TOKEN=
TAGO_METER_VALUES_MQTT_TOKEN=
TAGO_OCPP_REQUESTS_TOKEN=
# endregion

# region Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTICES_CHAT_ID=
TELEGRAM_BACKUPS_CHAT_ID=
# endregion
